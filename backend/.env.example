PORT=5000
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/appointer?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/appointer
# Generate a strong 32+ character random secret using: openssl rand -hex 32
JWT_SECRET=your_strong_random_32_character_jwt_secret_here
# Comma-separated allowed frontend origins for CORS (e.g. Vercel deployment URL and localhost)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app
